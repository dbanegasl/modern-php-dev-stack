# Local environment and secret files
.env
.secrets/

# Database data persistence
/docker/mariadb/data/
db-data/

# Application and service logs
*.log
docker/php/logs/

# Temporary reference clone
xampp8-docker-ref/

# macOS system files
.DS_Store

# Ignore all source code in the src folder except the placeholder .gitkeep and index.php
src/*
!src/.gitkeep
!src/index.php

# Ignore temp folder
temp/

# Per-project web server rules: only the *.example templates are versioned
docker/nginx/conf.d/*
!docker/nginx/conf.d/*.example
docker/apache/conf.d/*
!docker/apache/conf.d/*.example
